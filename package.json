{
  "name": "mark-of-the-veil",
  "version": "1.0.0",
  "private": true,
  "description": "An eight-chapter science-fantasy WebGL action campaign with first-person and third-person combat.",
  "license": "MIT",
  "homepage": "https://mark-of-the-veil.burry.io/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Burry/mark-of-the-veil.git"
  },
  "bugs": {
    "url": "https://github.com/Burry/mark-of-the-veil/issues"
  },
  "keywords": [
    "browser-game",
    "gamepad",
    "react",
    "science-fantasy",
    "threejs",
    "typescript",
    "vite",
    "web-audio",
    "webgl"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "engines": {
    "node": ">=22.13 <25"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.185.1",
    "three-gpu-pathtracer": "^0.0.24",
    "three-mesh-bvh": "^0.9.14",
    "xatlas-web": "^0.1.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/three": "0.185.4",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.8.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.9.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
